{
  "name": "@adguard/hostlist-compiler",
  "description": "A simple tool that compiles hosts blocklists from multiple sources",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "repository": "https://github.com/AdguardTeam/HostlistCompiler",
  "author": "AdGuard",
  "license": "GPL-3.0",
  "bin": {
    "hostlist-compiler": "src/cli.js"
  },
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:md",
    "lint:code": "eslint . --cache",
    "lint:md": "markdownlint .",
    "test": "jest --runInBand --detectOpenHandles .",
    "increment": "pnpm version patch --no-git-tag-version",
    "compile": "node src/cli.js"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.33.4 <11"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/eslint-parser": "7.19.1",
    "eslint": "8.34.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.27.5",
    "jest": "29.7.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "mock-fs": "4.11.0",
    "nock": "12.0.2"
  },
  "dependencies": {
    "@adguard/filters-downloader": "2.3.1",
    "ajv": "6.12.6",
    "better-ajv-errors": "0.6.7",
    "consola": "2.11.3",
    "lodash": "4.17.15",
    "tldts": "7.0.28",
    "yargs": "15.3.0"
  }
}
